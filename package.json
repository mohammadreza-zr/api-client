{
  "name": "@mohammadreza-zr/api-client",
  "version": "1.0.0",
  "description": "Dependency-free typed REST client with automatic token refresh, Web Worker isolation and cross-tab auth sync. Works in React, Vue, Next.js, Nuxt, SSR and plain JS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:worker": "tsx scripts/build-worker.ts",
    "build:bundle": "tsup",
    "build": "npm run build:worker && npm run build:bundle",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fetch",
    "api-client",
    "http-client",
    "rest",
    "token-refresh",
    "jwt",
    "web-worker",
    "multi-tab",
    "httponly",
    "typescript",
    "react",
    "vue",
    "nextjs",
    "nuxt",
    "ssr"
  ],
  "author": "mohammadreza-zr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadreza-zr/api-client.git"
  },
  "bugs": {
    "url": "https://github.com/mohammadreza-zr/api-client/issues"
  },
  "homepage": "https://github.com/mohammadreza-zr/api-client#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
