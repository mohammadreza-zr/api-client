{
  "name": "@your-scope/api-client",
  "version": "1.0.0",
  "description": "A typed, concurrency-safe API client with automatic token refresh and request queuing.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:worker": "tsx scripts/build-worker.ts",
    "build:main": "tsup",
    "build": "npm run build:worker && npm run build:main",
    "dev": "tsup --watch",
    "test": "vitest run",
    "server": "tsx playground/server.ts",
    "test:real": "tsx playground/test-real.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "api",
    "fetch",
    "token-refresh",
    "request-queue",
    "nextjs",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "qs": "^6.14.0"
  },
  "peerDependencies": {
    "sonner": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/qs": "^6.15.1",
    "cors": "^2.8.6",
    "eslint": "^9.0.0",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "msw": "^2.15.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
